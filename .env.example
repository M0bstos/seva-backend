# Read by config.toml's env() lookups. Copy to .env and fill in.
# Never commit .env. Values here are names only.

# Custom SMTP through Amazon SES (spec §9.3)
SUPABASE_AUTH_SMTP_PASS=

# Cloudflare Turnstile (spec §9.3)
SUPABASE_AUTH_CAPTCHA_SECRET=

# Google and Apple sign-in (spec §2.1)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Proves a Send SMS hook request came from Supabase Auth (spec §9.5)
SEVA_SEND_SMS_HOOK_SECRET=
