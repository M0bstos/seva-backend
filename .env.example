# Read by config.toml's env() lookups. Copy to .env and fill in.
# Never commit .env. Values here are names only.

# Custom SMTP through Amazon SES (spec §9.3)
SUPABASE_AUTH_SMTP_PASS=

# Cloudflare Turnstile (spec §9.3)
SUPABASE_AUTH_CAPTCHA_SECRET=

# Google and Apple sign-in (spec §2.1)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Proves a Send SMS hook request came from Supabase Auth (spec §9.5)
SEVA_SEND_SMS_HOOK_SECRET=

# Browser origins the four public route groups answer, comma-separated (spec §17 O37).
# Unset allows none, which is what a native-only client needs.
SEVA_ALLOWED_ORIGINS=

# Keys the per-address limiter hash for the local stack (spec §17 O26). config.toml
# passes it to the edge runtime, so `supabase start` needs it before the four public
# `discover` routes will serve an anonymous caller. Any value will do locally.
SEVA_RATE_LIMIT_SALT=
