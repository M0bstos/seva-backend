# Read by config.toml's env() lookups. Copy to .env and fill in.
# Never commit .env. Values here are names only.

# Custom SMTP through Amazon SES (spec §9.3)
SUPABASE_AUTH_SMTP_PASS=

# Cloudflare Turnstile (spec §9.3)
SUPABASE_AUTH_CAPTCHA_SECRET=

# Google and Apple sign-in (spec §2.1)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Proves a Send SMS hook request came from Supabase Auth (spec §9.5)
SEVA_SEND_SMS_HOOK_SECRET=

# Read at boot by the moderation worker (spec §4.2, §8.2). No AWS account yet, so
# these are placeholders locally; the worker boots and serves, and a send fails.
AWS_REGION=ap-south-1
SEVA_GUARDRAIL_ID=
SEVA_GUARDRAIL_VERSION=

# Read at boot by the Send SMS hook (spec §9.3, D16) and, for the first three plus the
# cancellation template, by the message worker (spec §2.1). Measured: without the first
# of these the hook does not boot at all, so `supabase start` needs a value here even
# though no local stack reaches AWS. All five come from the DLT registration (§17 O4).
SEVA_SMS_ORIGINATION_IDENTITY=local-placeholder
SEVA_SMS_CONFIGURATION_SET=local-placeholder
SEVA_SMS_DLT_ENTITY_ID=local-placeholder
SEVA_SMS_TEMPLATE_ID_OTP=local-placeholder
SEVA_SMS_TEMPLATE_ID_CANCELLATION=local-placeholder

# The SES sending address (spec §9.3), read at boot by the message worker.
SEVA_EMAIL_FROM=no-reply@seva.test

# Browser origins the four public route groups answer, comma-separated (spec §17 O37).
# Unset allows none, which is what a native-only client needs.
SEVA_ALLOWED_ORIGINS=

# Keys the per-address limiter hash for the local stack (spec §17 O26). config.toml
# passes it to the edge runtime, so `supabase start` needs it before the four public
# `discover` routes will serve an anonymous caller. Any value will do locally.
SEVA_RATE_LIMIT_SALT=
