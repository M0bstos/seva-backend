# Read by `supabase functions serve`. Copy to supabase/functions/.env.
# The CLI reads this file, not the repo-root .env. Never commit the real one.
#
# Not defined here: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS
# and SUPABASE_DB_URL are injected by the platform. Custom names cannot start
# with SUPABASE_ on hosted Edge Functions, hence the SEVA_ prefix.
#
# SUPABASE_SECRET_KEYS is a JSON object keyed by key name. Each function reads
# its own entry, so any one key can be revoked alone (spec §9.5).

# Keys the per-IP rate limit hash so no raw address reaches Postgres (spec §17 O26)
SEVA_RATE_LIMIT_SALT=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Guardrails, text screening (spec §8.2)
SEVA_GUARDRAIL_ID=
SEVA_GUARDRAIL_VERSION=

# Amazon SES (spec §9.3)
SEVA_SES_FROM_ADDRESS=

# AWS End User Messaging SMS, DLT-registered local route (spec §14.2)
SEVA_SMS_ORIGINATION_IDENTITY=
SEVA_SMS_CONFIGURATION_SET=
SEVA_SMS_DLT_ENTITY_ID=
SEVA_SMS_TEMPLATE_ID_OTP=
SEVA_SMS_TEMPLATE_ID_CANCELLATION=

# Must match the value in the repo-root .env (spec §9.5)
SEVA_SEND_SMS_HOOK_SECRET=
